{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "patriasoul",
  "main": "worker.js",
  "compatibility_date": "2026-09-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "exclude": [
      ".git/**",
      "node_modules/**",
      "wrangler.jsonc"
    ]
  }
}
